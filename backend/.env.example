APP_NAME="Inside Cancun"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Cancun
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=inside_cancun
DB_USERNAME=inside_cancun
DB_PASSWORD=secret

# --- Redis (cache, queues, sessions) ---
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@insidecancun.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Filesystem ---
FILESYSTEM_DISK=local

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Payments (se define proveedor en Fase 13; no dejar vacío en prod) ---
PAYMENTS_PROVIDER=
PAYMENTS_PUBLIC_KEY=
PAYMENTS_SECRET_KEY=

# --- Integraciones externas (Fase 10-12, NUNCA exponer al frontend) ---
BOKUN_API_KEY=
BOKUN_API_SECRET=
BOKUN_BASE_URL=

VIATOR_API_KEY=
VIATOR_BASE_URL=

GYG_API_KEY=
GYG_BASE_URL=
